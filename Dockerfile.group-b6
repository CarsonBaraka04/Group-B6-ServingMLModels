
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install production dependencies
COPY requirements/group_b6.txt requirements/group_b6.txt

RUN python -m pip install --no-cache-dir \
    -r requirements/group_b6.txt

# Copy Group B6 Flask application
COPY api.py ./
COPY group_b6_regression_api.py ./
COPY group_b6_classification_api.py ./
COPY group_b6_clustering_api.py ./
COPY group_b6_pharmacy_api.py ./

# Copy trained models and association rules
RUN mkdir -p model

COPY model/group_b6_student_exam_regression.joblib model/
COPY model/group_b6_fraud_classifier.joblib model/
COPY model/group_b6_bank_clustering.joblib model/
COPY model/group_b6_pharmacy_rules.json model/

EXPOSE 5000

# Start the application with Gunicorn
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--timeout", "120", "api:app"]
